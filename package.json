{
  "name": "review",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#db-runtime": "./src/db/sqlite.ts"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:cf": "DEPLOY_TARGET=cloudflare vite build",
    "build:node": "DEPLOY_TARGET=node vite build",
    "preview": "vite preview",
    "preview:cf": "DEPLOY_TARGET=cloudflare vite preview",
    "deploy:cf": "DEPLOY_TARGET=cloudflare vite build && wrangler deploy",
    "deploy:vps": "DEPLOY_TARGET=node vite build && node .output/server/index.mjs",
    "cf-typegen": "wrangler types",
    "d1:migrate": "wrangler d1 migrations apply ternak-review --local",
    "d1:migrate:remote": "wrangler d1 migrations apply ternak-review --remote",
    "d1:migrate:test": "tsx scripts/d1-migration-flow.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:backup:d1": "tsx scripts/backup-db.ts --d1 --remote",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run smoke && npm run security && npm run d1:migrate:test",
    "prepare": "git config core.hooksPath .githooks",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "smoke": "tsx scripts/smoke-flow.ts",
    "gateway:stub": "tsx scripts/whatsapp-stub.ts",
    "security": "tsx scripts/security-flow.ts",
    "security:runtime": "tsx scripts/runtime-security-flow.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.30",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.47",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.33.0",
    "nanoid": "^6.0.1",
    "nodemailer": "^10.0.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-cli": "^1.132.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "nitro": "npm:nitro-nightly@3.0.1-20260821-005124-e36e7a60",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
