        "service_packages_tier_check": {
          "name": "service_packages_tier_check",
          "value": "\"service_packages\".\"service_tier\" IN ('BASIC', 'PLUS', 'PRO')"
        },
        "service_packages_name_check": {
          "name": "service_packages_name_check",
          "value": "length(trim(\"service_packages\".\"name\")) BETWEEN 1 AND 40"
        },
        "service_packages_intercept_check": {
          "name": "service_packages_intercept_check",
          "value": "typeof(\"service_packages\".\"intercept_max_rating\") = 'integer' AND ((\"service_packages\".\"service_tier\" = 'BASIC' AND \"service_packages\".\"intercept_max_rating\" = 0) OR (\"service_packages\".\"service_tier\" IN ('PLUS', 'PRO') AND \"service_packages\".\"intercept_max_rating\" BETWEEN 1 AND 5))"
        }
      }
    },
