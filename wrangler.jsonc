{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ternak-review",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.cloudflare.ts",
  "observability": {
    "enabled": true,
  },
  // Lets Sentry tag server events with the deployed Worker version.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "vars": {
    "NODE_ENV": "production",
    "APP_URL": "https://ternakreview.com",
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "ternakreview.com/*", "zone_name": "ternakreview.com" },
    { "pattern": "www.ternakreview.com/*", "zone_name": "ternakreview.com" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ternak-review",
      "migrations_dir": "drizzle",
      "database_id": "8e0872b5-675a-4511-8764-ae0ed44b3370",
    },
  ],
}
