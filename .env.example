# Public origin baked into printed QR and NTAG215. Set the HTTPS production
# URL before print/encode — changing it later does not update cards already made.
# Same value on Cloudflare and VPS — kartu tidak ikut pindah host.
APP_URL=http://localhost:3000

# Local + VPS: SQLite file. Cloudflare memakai D1 (binding DB), URL ini diabaikan.
DATABASE_URL=file:./data/dev.db

# Auth / hashing
AUTH_SECRET=change-me-to-a-long-random-string
IP_HASH_SALT=change-me-to-a-different-long-random-string
# Required only when creating the very first admin. Keep it secret afterward so
# an accidentally emptied/restored database cannot be claimed by a stranger.
ADMIN_SETUP_TOKEN=change-me-to-another-long-random-string

# VPS only: enable this only behind a trusted reverse proxy that overwrites
# X-Real-IP / X-Forwarded-For. Leave false when exposing Node directly.
TRUST_PROXY=false

# Google Places: Admin → Google Maps. Affiliate webhook: Admin → Affiliate.
# Jangan taruh key/URL itu di sini.

# Optional until WhatsApp Pro is enabled. Use a random 32+ character token.
# Local test without a phone: npm run gateway:stub (same token as the app).
WHATSAPP_GATEWAY_TOKEN=

# Optional: Sentry DSN for local development. Kosongkan untuk mematikan Sentry
# di lokal. Build produksi membaca DSN dari .env.production.
VITE_SENTRY_DSN=
